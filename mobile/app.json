{
  "expo": {
    "name": "Prangan",
    "slug": "prangan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16307A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.javedrnc.prangan",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "prangan",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Prangan uses your location only when you check in or out, to confirm you're at school."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1E4D3F",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Mukta",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Mukta_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Mukta_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Mukta_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Mukta_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Mukta_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Bricolage",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Mukta_400Regular.ttf",
              "./assets/fonts/Mukta_500Medium.ttf",
              "./assets/fonts/Mukta_600SemiBold.ttf",
              "./assets/fonts/Mukta_700Bold.ttf",
              "./assets/fonts/Mukta_800ExtraBold.ttf",
              "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
              "./assets/fonts/BricolageGrotesque_700Bold.ttf",
              "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://school-api-7y80.onrender.com"
    }
  }
}
