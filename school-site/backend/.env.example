# Copy this file to ".env" and fill in real values. Never commit the real .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave unset to use a local SQLite file (zero setup). For Postgres (recommended for real use):
# DATABASE_URL=postgres://schoolsite:schoolsite@localhost:5432/schoolsite
DATABASE_URL=

# --- Frontend (the Next.js site) origin(s), comma-separated. Only these may call the API from a browser. ---
FRONTEND_ORIGINS=http://localhost:3000

# --- Razorpay (donations / zakat). Leave blank to run without payments. Use TEST keys for development. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Production only ---
# SECURE_SSL_REDIRECT=True
